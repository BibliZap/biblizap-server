# Public URL: checking through HTTPS also covers DNS, TLS, and the reverse proxy.
HEALTHCHECK_URL=https://example.com/health

CHECK_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=10
FAILURE_THRESHOLD=2
RUST_LOG=info

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
# starttls (usually port 587), implicit (usually port 465), or none
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10

ALERT_FROM=monitor@example.com
# Separate multiple recipients with commas.
ALERT_TO=you@example.com
