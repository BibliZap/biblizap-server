[Unit]
Description=BibliZap server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=biblizap
Group=biblizap
Environment=RUST_LOG=info
ExecStart=/usr/bin/biblizap-server --config /etc/biblizap/biblizap.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
