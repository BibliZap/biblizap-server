[Unit]
Description=BibliZap external health monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=biblizap-monitor
Group=biblizap-monitor
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/biblizap-monitor --config /etc/biblizap-monitor/biblizap-monitor.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
